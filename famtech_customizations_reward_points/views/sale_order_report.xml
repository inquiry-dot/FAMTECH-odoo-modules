<odoo>
  <template id="report_saleorder_document_inherit"
            inherit_id="sale.report_saleorder_document">

    <xpath expr="//div[@class='article']" position="after">

      <p>
        <strong>Current Reward Points:</strong>
        <span t-esc="o.partner_id.loyalty_points"/>
      </p>

      <p>
        <strong>Points to Earn if Confirmed:</strong>
        <span t-esc="o.points_to_earn"/>
      </p>

    </xpath>

  </template>
</odoo>