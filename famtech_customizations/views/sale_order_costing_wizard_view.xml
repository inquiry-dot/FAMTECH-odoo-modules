<odoo>
  <record id="view_sale_order_costing_wizard_form" model="ir.ui.view">
    <field name="name">sale.order.costing.wizard.form</field>
    <field name="model">sale.order.costing.wizard</field>
    <field name="arch" type="xml">
      <form string="Quotation Costing Calculator">
        <group>
          <field name="cost_price"/>
          <field name="markup_percent"/>
          <field name="discount_percent"/>
          <field name="computed_price" readonly="1"/>
        </group>
        <footer>
          <button string="Apply to Order" type="object" name="apply_to_order" class="btn-primary"/>
          <button string="Cancel" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>