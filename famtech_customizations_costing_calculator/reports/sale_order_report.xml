<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_inherit_costing" inherit_id="sale.report_saleorder_document">
        
        <xpath expr="//div[@id='total']" position="after">
            <div t-if="doc.cost_price and doc.cost_price > 0" class="clearfix" style="page-break-inside: avoid; margin-top: 30px;">
                <div class="row">
                    <div class="col-12">
                        <h5 style="border-bottom: 2px solid #875a7b; padding-bottom: 10px; margin-bottom: 20px;">
                            <i class="fa fa-calculator"/> Cost Breakdown &amp; Profitability Analysis
                        </h5>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-6">
                        <table class="table table-sm table-borderless w-100">
                            <tbody>
                                <tr>
                                    <td style="width: 60%;"><strong>Estimated Cost Price:</strong></td>
                                    <td class="text-end" style="width: 40%;">
                                        <span t-field="doc.cost_price" 
                                              t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Markup:</strong></td>
                                    <td class="text-end">
                                        <span t-esc="'%.2f' % (doc.markup_percent or 0.0)"/>%
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Discount:</strong></td>
                                    <td class="text-end">
                                        <span t-esc="'%.2f' % (doc.discount_percent or 0.0)"/>%
                                    </td>
                                </tr>
                                <tr style="background-color: #f8f9fa9f;">
                                    <td style="width: 60%;"><strong>Final Computed Price:</strong></td>
                                    <td class="text-end" style="width: 40%;">
                                        <strong>
                                            <span t-field="doc.computed_price" 
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </strong>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>