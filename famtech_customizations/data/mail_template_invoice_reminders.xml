<odoo>
    <data noupdate="1">
        <record id="email_template_invoice_reminder_gentle" model="mail.template">
            <field name="name">Invoice: Gentle Reminder (3 Days Before)</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">Upcoming Due Date: Invoice {{ object.name }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif;">
                    <p>Hello <t t-out="object.partner_id.name"/>,</p>
                    <p>Invoice <strong><t t-out="object.name"/></strong> is due on <strong><t t-out="object.invoice_date_due"/></strong>.</p>
                </div>
            </field>
        </record>

        <record id="email_template_invoice_reminder_overdue" model="mail.template">
            <field name="name">Invoice: Overdue Reminder (1 Day After)</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">Overdue Notice: Invoice {{ object.name }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif;">
                    <p>Hello <t t-out="object.partner_id.name"/>,</p>
                    <p>Invoice <strong><t t-out="object.name"/></strong> is now overdue. Click below to request a callback.</p>
                    <a t-attf-href="mailto:{{ object.company_id.email }}?subject=Callback Request: {{ object.name }}" 
                       style="background-color: #875A7B; padding: 10px; color: #fff; text-decoration: none; border-radius: 5px;">Request Callback</a>
                </div>
            </field>
        </record>
    </data>
</odoo>